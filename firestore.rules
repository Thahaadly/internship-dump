rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /internship_photos/{document=**} {
      allow read, write: if true;
    }
    match /members/{document=**} {
      allow read, write: if true;
    }
    match /stories/{document=**} {
      allow read, write: if true;
    }
  }
}
